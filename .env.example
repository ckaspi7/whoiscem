# OpenAI
OPENAI_API_KEY=sk-...

# Observability — Arize Phoenix over OpenTelemetry / OpenInference.
# Leave the endpoint unset to trace to a local collector (pip install arize-phoenix
# && phoenix serve, http://localhost:6006) with no account and nothing to configure.
# Set both to send traces to Phoenix Cloud instead.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=whoiscem

# ---------------------------------------------------------------------------
# Vector store backend
#   embedded — on-disk Qdrant in QDRANT_PATH. No server, no Docker. Default.
#              One process at a time: the client locks the directory.
#   server   — Qdrant over HTTP (docker-compose, Podman, a local binary).
#   cloud    — Qdrant Cloud; requires QDRANT_URL and QDRANT_API_KEY.
# ---------------------------------------------------------------------------
QDRANT_MODE=embedded
QDRANT_PATH=.qdrant

# QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333

# QDRANT_MODE=cloud
# QDRANT_URL=https://xxxxxxxx.region.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# Resume indexed on first run. Markdown or PDF; Markdown keeps section structure.
RESUME_PATH=data/resume.md

# Session memory. Unset — the default — keeps summaries in-process instead,
# so the app runs with no Redis. Set it to use a real server.
# REDIS_URL=redis://localhost:6379

# Spotify (only needed to refresh data/cache/spotify_cache.json locally)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
