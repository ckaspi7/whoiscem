# OpenAI
OPENAI_API_KEY=sk-...

# LangSmith (optional but recommended for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=howtocem
LANGCHAIN_API_KEY=ls__...

# Spotify (only needed to refresh data/cache/spotify_cache.json locally)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Redis (for cross-session memory)
REDIS_URL=redis://localhost:6379

# Qdrant (local Docker default — no changes needed for docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
