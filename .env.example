# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic. Needed by default: the default CHAT_MODEL is a Claude model (and any
# Claude FALLBACK_CHAT_MODEL needs it too). Not needed if you set CHAT_MODEL to an
# OpenAI model and leave FALLBACK_CHAT_MODEL empty.
# Use a key created for this project. The Anthropic SDK also reads ANTHROPIC_BASE_URL
# and ANTHROPIC_AUTH_TOKEN if they are set in your shell (some tools set them); that
# would send this key to that endpoint, so unset them for this project.
ANTHROPIC_API_KEY=sk-ant-...

# Observability — Arize Phoenix over OpenTelemetry / OpenInference.
# Leave the endpoint unset to trace to a local collector (pip install arize-phoenix
# && phoenix serve, http://localhost:6006) with no account and nothing to configure.
# Set both to send traces to Phoenix Cloud instead.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=whoiscem

# ---------------------------------------------------------------------------
# Vector store backend
#   embedded — on-disk Qdrant in QDRANT_PATH. No server, no Docker. Default.
#              One process at a time: the client locks the directory.
#   server   — Qdrant over HTTP (docker-compose, Podman, a local binary).
#   cloud    — Qdrant Cloud; requires QDRANT_URL and QDRANT_API_KEY.
# ---------------------------------------------------------------------------
QDRANT_MODE=embedded
QDRANT_PATH=.qdrant

# QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333

# QDRANT_MODE=cloud
# QDRANT_URL=https://xxxxxxxx.region.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# Resume indexed on first run. Markdown or PDF; Markdown keeps section structure.
RESUME_PATH=data/resume.md

# ---------------------------------------------------------------------------
# Agent architecture and chat model — both measured, not assumed. See the
# README's model/architecture comparison tables before changing either.
#   AGENT_MODE=classifier    — an LLM picks one of five labels, a switch calls
#                              one tool. Default: wins on routing/faithfulness.
#   AGENT_MODE=tool_calling  — tools bound directly to the LLM; it chooses,
#                              calls zero-to-many, loops back with results.
#   CHAT_MODEL=claude-haiku-5-5 — default (needs ANTHROPIC_API_KEY). Best
#                              faithfulness and scope discipline of the three
#                              models measured, at about 1.2x gpt-4o-mini's
#                              cost per question (ADR-0011).
#   CHAT_MODEL=gpt-6-luna    — the cheapest, and the default fallback. Works
#                              under both AGENT_MODE values at
#                              reasoning_effort "none", which models.py sets.
#   CHAT_MODEL=gpt-4o-mini   — retires 2027-01-14; kept until then as the
#                              eval baseline's reference.
#   FALLBACK_CHAT_MODEL=<model> — answers when CHAT_MODEL fails (an outage, a rate
#                              limit, an exhausted balance); each switch is logged.
#                              Must differ from CHAT_MODEL. Best from the other
#                              provider, since a same-provider fallback does not help
#                              when that account is out of credit. Unset, it is
#                              gpt-6-luna while CHAT_MODEL is the default and none
#                              otherwise; set it empty to turn it off.
# ---------------------------------------------------------------------------
AGENT_MODE=classifier
# CHAT_MODEL=claude-haiku-5-5
# FALLBACK_CHAT_MODEL=gpt-6-luna

# Session memory and the retrieval cache. Unset — the default — keeps both
# in-process instead, so the app runs with no Redis. Set it to use a real
# server, e.g. Upstash's free tier: paste its "Redis URL" as given, including
# the rediss:// (TLS) scheme — redis_backend.py's redis.from_url() handles
# rediss:// natively, no extra config needed.
# REDIS_URL=rediss://default:your_password@your-endpoint.example.com:6379

# Signs the ?sid= session link (Phase 4.5) so an edited or fabricated one is
# rejected rather than accepted as a previously-issued session. Unset — the
# default — falls back to a random secret generated per process start:
# signed links still work, but only until the process restarts. Set this for
# any deployment expected to survive one.
# SESSION_SECRET=

# Spotify (only needed to refresh data/cache/spotify_cache.json locally)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ---------------------------------------------------------------------------
# Headless API only (api.py — uvicorn api:app). Not read by the Streamlit
# app, which does not yet call through this service — see LIMITATIONS.md.
#   API_KEY               — checked against the X-API-Key header. Unset means
#                            no auth, loudly logged; fine for local dev, not
#                            for a real deployment. Meant to be held only by
#                            the frontend's own server-side proxy route, never
#                            baked into client-side JS — a value shipped to
#                            the browser is readable in the network tab and
#                            protects nothing.
#   FRONTEND_ORIGIN       — CORS origin allowed to call this API. Defaults to
#                            the Next.js dev server (http://localhost:3000);
#                            a real deployment must set this to the actual
#                            Netlify origin. Defense-in-depth only — the
#                            frontend's proxy calls this API server-to-server,
#                            which isn't subject to CORS at all.
#   RATE_LIMIT_PER_MINUTE — default 20, per visitor IP (X-Forwarded-For first,
#                            then the connecting socket) — never per API key,
#                            since a real deployment has exactly one shared
#                            key and keying by it would merge every visitor
#                            into a single bucket.
#   DAILY_SPEND_CAP_USD   — default 5.00. /chat returns 402 once reached.
# ---------------------------------------------------------------------------
# API_KEY=
# FRONTEND_ORIGIN=http://localhost:3000
# RATE_LIMIT_PER_MINUTE=20
# DAILY_SPEND_CAP_USD=5.00
