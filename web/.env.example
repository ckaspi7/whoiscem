# Server-side only - read exclusively by app/api/chat/route.ts. Never
# prefix either of these with NEXT_PUBLIC_: that prefix is what makes
# Next.js inline a value into the browser bundle, so the backend key would
# otherwise leak straight to visitors.

# Base URL of the FastAPI backend (api.py), no trailing slash.
BACKEND_API_URL=https://your-backend-host.example.com

# Must match the backend's own API_KEY env var.
BACKEND_API_KEY=replace-with-the-real-backend-api-key
