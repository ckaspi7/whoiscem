# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# The repo root's .gitignore has a generic Python-boilerplate `lib/` rule
# (venv/packaging artifacts) that, being unanchored, also matches this
# project's own web/lib/ - our actual application code (the API client,
# shared types). Un-ignore it here rather than touching the shared root
# .gitignore, which other, non-frontend parts of this repo still rely on.
!/lib/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
