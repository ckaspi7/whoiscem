# Template for Streamlit Community Cloud's Settings -> Secrets box, not a
# file the app reads directly (.streamlit/secrets.toml is gitignored and
# only matters for local testing of this exact mechanism). Streamlit Cloud
# has no .env file, so this box is the only way to configure the app there —
# chatbot.py's _apply_streamlit_secrets() copies exactly the keys listed in
# _SECRET_KEYS from here into os.environ before the graph is built. Anything
# not in that list (there is currently nothing else settable) would be
# silently ignored. See .env.example for what each setting does.

OPENAI_API_KEY = "sk-..."

# Needed by default: the default CHAT_MODEL is a Claude model.
ANTHROPIC_API_KEY = "sk-ant-..."

QDRANT_MODE = "cloud"
QDRANT_URL = "https://xxxxxxxx.region.aws.cloud.qdrant.io"
QDRANT_API_KEY = "..."

REDIS_URL = "rediss://default:your_password@your-endpoint.example.com:6379"

# Without this, signed session links (Phase 4.5) stop verifying every time
# the app restarts, since the fallback secret is random-per-process. Generate
# one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET = "generate-a-random-string-here"

# Optional overrides — both already default to these values, so leave them
# out unless deliberately overriding (ADR-0011). The fallback defaults to
# gpt-6-luna while CHAT_MODEL is the default; set it to "" to turn it off.
# AGENT_MODE = "classifier"
# CHAT_MODEL = "claude-haiku-5-5"
# FALLBACK_CHAT_MODEL = "gpt-6-luna"

# Optional — Phoenix Cloud tracing. Omit both to trace to a local collector
# instead, which a deployed instance can't reach, so tracing is effectively
# off until these are set.
# PHOENIX_COLLECTOR_ENDPOINT = "https://app.phoenix.arize.com/s/your-space"
# PHOENIX_API_KEY = "..."
